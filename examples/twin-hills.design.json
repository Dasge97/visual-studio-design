  "components": {},
  "tokens": {
    "accent": {
      "id": "accent",
      "name": "Acento",
      "type": "color",
      "value": "#0f766e"
    },
    "text": {
      "id": "text",
      "name": "Texto",
      "type": "color",
      "value": "#17212b"
    }
  },
  "viewports": {
    "desktop": {
      "id": "desktop",
      "name": "Escritorio",
      "width": 1280,
      "height": 720
    },
    "compact": {
      "id": "compact",
      "name": "Compacto",
      "width": 960,
      "height": 540
    }
  },
  "variables": {
    "money": {
      "id": "money",
      "name": "Dinero",
      "type": "number",
      "default": 250
    },
    "progress": {
      "id": "progress",
      "name": "Progreso",
      "type": "number",
      "default": 40
    }
  },
  "scenarios": {
    "normal": {
      "id": "normal",
      "name": "Partida normal",
      "screenId": "hud",
      "values": {
        "money": 250,
        "progress": 40
      },
      "visibility": {
        "upgrade-panel": false
      }
    },
    "no-resources": {
      "id": "no-resources",
      "name": "Sin recursos",
      "screenId": "hud",
      "values": {
        "money": 0,
        "progress": 40
      },
      "visibility": {
        "upgrade-panel": true
      }
    },
    "upgrade-available": {
      "id": "upgrade-available",
      "name": "Mejora disponible",
      "screenId": "hud",
      "values": {
        "money": 250,
        "progress": 40
      },
      "visibility": {
        "upgrade-panel": true
      }
    }
  },
  "stateRules": {
    "cannot-buy": {
      "id": "cannot-buy",
      "nodeId": "buy-upgrade",
      "priority": 10,
      "when": {
        "op": "lt",
        "left": {
          "kind": "variable",
          "variableId": "money"
        },
        "right": {
          "kind": "literal",
          "value": 100
        }
      },
      "overrides": {
        "enabled": false,
        "appearance": {
          "opacity": 0.4
        }
      }
    }
  },
  "interactions": {
    "open": {
      "id": "open",
      "nodeId": "open-upgrades",
      "event": "click",
      "actions": [
        {
          "type": "setVisible",
          "nodeId": "upgrade-panel",
          "value": true
        }
      ]
    },
    "close": {
      "id": "close",
      "nodeId": "close-upgrades",
      "event": "click",
      "actions": [
        {
          "type": "setVisible",
          "nodeId": "upgrade-panel",
          "value": false
        }
      ]
    },
    "buy": {
      "id": "buy",
      "nodeId": "buy-upgrade",
      "event": "click",
      "actions": [
        {
          "type": "incrementVariable",
          "variableId": "money",
          "amount": -100
        }
      ],
      "when": {
        "op": "gte",
        "left": {
          "kind": "variable",
          "variableId": "money"
        },
        "right": {
          "kind": "literal",
          "value": 100
        }
      }
    }
  },
  "assetIds": []
}
