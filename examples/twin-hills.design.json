        }
      },
      "appearance": {
        "textColor": {
          "tokenId": "text"
        }
      },
      "visible": true,
      "enabled": true,
      "zIndex": 0,
      "content": {
        "kind": "binding",
        "variableId": "progress",
        "prefix": "Progreso: ",
        "suffix": "%"
