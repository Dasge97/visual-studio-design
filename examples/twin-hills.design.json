      "childrenLayout": {
        "mode": "column",
        "gap": 12,
        "padding": 16,
        "align": "start",
        "justify": "start"
      }
    },
    "upgrade-title": {
      "id": "upgrade-title",
      "name": "upgrade-title",
      "type": "text",
      "layout": {
        "mode": "flow-child",
        "width": {
          "mode": "fixed",
          "value": 300
        },
        "height": {
          "mode": "fixed",
          "value": 40
        }
      },
      "appearance": {},
      "visible": true,
      "enabled": true,
      "zIndex": 0,
      "content": {
        "kind": "literal",
        "text": "Mejora de ejemplo · 100 monedas"
      }
    },
    "buy-upgrade": {
      "id": "buy-upgrade",
      "name": "buy-upgrade",
      "type": "text",
      "layout": {
        "mode": "flow-child",
        "width": {
          "mode": "fixed",
          "value": 200
        },
        "height": {
          "mode": "fixed",
          "value": 40
        }
      },
      "appearance": {
        "fill": {
